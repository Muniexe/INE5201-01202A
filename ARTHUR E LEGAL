#include <SPI.h>
#include <SD.h>

/*
LIGAÇÕES DO MÓDULO SD NO ESP32

SD -> ESP32
VCC -> 5V
GND -> GND
MISO -> GPIO19
MOSI -> GPIO23
SCK -> GPIO18
CS -> GPIO5
*/

#define SD_CS 5

File arquivo;

void setup() {

  Serial.begin(115200);

  Serial.println("Iniciando SD Card...");

  // Inicializa SPI do ESP32
  SPI.begin(18, 19, 23, SD_CS);

  // Inicializa SD
  if (!SD.begin(SD_CS)) {
    Serial.println("Erro no SD Card!");
    while (1);
  }

  Serial.println("SD Card OK!");

  // Abre/cria arquivo
  arquivo = SD.open("/DADOS.TXT", FILE_WRITE);

  if (arquivo) {

    Serial.println("Escrevendo dados...");

    int temperatura = 25;
    float tensao = 4.87;

    arquivo.print("Temperatura: ");
    arquivo.print(temperatura);
    arquivo.println(" C");

    arquivo.print("Tensao: ");
    arquivo.print(tensao);
    arquivo.println(" V");

    arquivo.println("----------------");

    // força salvar
    arquivo.flush();

    // fecha arquivo
    arquivo.close();

    Serial.println("Dados salvos!");

  } else {

    Serial.println("Erro ao abrir arquivo.");

  }
}

